  "_source": "tests/fixtures/stop-hook-65169/settings-hypothetical.json",
  "_related_issue": "https://github.com/anthropics/claude-code/issues/65169",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash tests/fixtures/stop-hook-65169/stub-stop-hook.sh",
            "_comment": "Stop hook: セッション終了時に発火（#65169 解消後に有効化想定）"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
