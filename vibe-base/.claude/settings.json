          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-use-failure-triage.mjs",
            "statusMessage": "微細エラー判定支援中（要検証・claude --debugで発火確認前）..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=session-start-handover-inject -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start-handover-inject.mjs",
            "statusMessage": "前回引継ぎレポート強制注入中..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=session-start-toranomaki -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start-toranomaki.mjs",
            "statusMessage": "虎の巻 outbox 取込チェック中..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=session-start-vault-reflection-check -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start-vault-reflection-check.mjs",
            "statusMessage": "vault 反映の滞留チェック中..."
          }
        ]
      },
      {
        "hooks": [
