      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=memory-size-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory-size-gate.mjs",
            "statusMessage": "memory 系ファイル byte 上限チェック中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=portfolio-deploy-build-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/portfolio-deploy-build-gate.mjs",
